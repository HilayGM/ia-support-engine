# Copia este archivo a `.env` y reemplaza el valor. NUNCA subas `.env` a Git.
GEMINI_API_KEY=tu_api_key_aqui

# Opcional: modelo de Gemini a usar (por defecto gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Opcional: punto de entrada del motor generativo usado por FastAPI
AI_SUPPORT_GENERATIVE_CALLABLE=src.engines.generative:analyze_generative
